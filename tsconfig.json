{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {"@/*": ["./apps/web/src/*"]}
  },
  "include": ["packages/**/*.ts", "apps/**/*.ts", "apps/**/*.tsx", "scripts/*.ts", "tests/**/*.ts", "playwright.config.ts", "vitest.config.ts"],
  "exclude": ["node_modules", "apps/web/node_modules", "apps/web/.next", "apps/collector/.next", "**/node_modules"]
}
